# --- ADMIN: BAJARISH / RAD ETISH / BAHOLASH ---
# =========================================================
async def admin_button_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    message = query.message

    if data.startswith("order_done_"):
        order_id = int(data.split("_")[2])
        order = db.get_order(order_id)
        if not order:
            await query.edit_message_text("Buyurtma topilmadi.")
            return
        target_user_id = order["user_id"]
        db.update_order_status(order_id, "done")

        base_text = message.text_html or message.text or ""
        new_text = base_text + "\n\n🟢 <b>TUGALLANDI</b>"
        await query.edit_message_text(text=new_text, parse_mode="HTML")

        rate_keyboard = InlineKeyboardMarkup([[
            InlineKeyboardButton(f"{n}⭐", callback_data=f"rate_{order_id}_{n}") for n in range(1, 6)
        ]])
        try:
            await context.bot.send_message(
                chat_id=target_user_id,
                text="🎉 Sizning buyurtmangiz muvaffaqiyatli bajarildi!\nXizmatimizni baholab bering:",
                reply_markup=rate_keyboard
            )
        except Exception as e:
            logger.warning(f"Foydalanuvchiga xabar yuborilmadi: {e}")

    elif data.startswith("order_reject_menu_"):
        order_id = data.split("_")[3]
        reason_keyboard = InlineKeyboardMarkup([
            [InlineKeyboardButton("💸 To'lanmadi", callback_data=f"reject_unpaid_{order_id}")],
            [InlineKeyboardButton("⚠️ Xato buyurtma", callback_data=f"reject_wrong_{order_id}")],
            [InlineKeyboardButton("⬅️ Bekor qilish", callback_data=f"reject_cancel_{order_id}")]
        ])
        await query.edit_message_reply_markup(reply_markup=reason_keyboard)


async def reject_reason_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    data = query.data
    message = query.message

    if data.startswith("reject_cancel_"):
        order_id = data.split("_")[2]
        original_keyboard = InlineKeyboardMarkup([[
            InlineKeyboardButton("✅ Bajarildi", callback_data=f"order_done_{order_id}"),
            InlineKeyboardButton("❌ Rad etildi", callback_data=f"order_reject_menu_{order_id}")
        ]])
        await query.edit_message_reply_markup(reply_markup=original_keyboard)
        return

    if data.startswith("reject_unpaid_"):
        reason_key = "unpaid"
        order_id = int(data.split("_")[2])
    elif data.startswith("reject_wrong_"):
        reason_key = "wrong"
        order_id = int(data.split("_")[2])
    else:
        return

    order = db.get_order(order_id)
    if not order:
        await query.edit_message_text("Buyurtma topilmadi.")
        return
    target_user_id = order["user_id"]
    reason_label = REJECT_REASON_LABELS[reason_key]

    db.update_order_status(order_id, "rejected", reason_label)

    base_text = message.text_html or message.text or ""
    new_text = base_text + f"\n\n🔴 <b>RAD ETILDI</b>\nSabab: {reason_label}"
    await query.edit_message_text(text=new_text, parse_mode="HTML")

    try:
        await context.bot.send_message(
            chat_id=target_user_id,
            text=f"❌ Sizning buyurtmangiz rad etildi.\nSabab: {reason_label}"
        )
    except Exception as e:
        logger.warning(f"Foydalanuvchiga xabar yuborilmadi: {e}")


async def rating_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    data = query.data
    parts = data.split("_")
    order_id = int(parts[1])
    score = int(parts[2])
    db.set_rating(order_id, score)
    await query.answer("Rahmat!")
    await query.edit_message_text(f"Bahoyingiz uchun rahmat! Siz {score}⭐ qo'ydingiz.")


