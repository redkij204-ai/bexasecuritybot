# --- MAJBURIY OBUNA (bir nechta kanal bo'lishi mumkin) ---
# =========================================================
async def check_subscription(user_id, context: ContextTypes.DEFAULT_TYPE):
    channels = db.get_required_channels()
    not_subbed = []
    for ch in channels:
        try:
            member = await context.bot.get_chat_member(chat_id=ch, user_id=user_id)
            if member.status not in ['member', 'administrator', 'creator']:
                not_subbed.append(ch)
        except Exception as e:
            logger.warning(f"{ch} obunasini tekshirishda xatolik: {e}")
            not_subbed.append(ch)
    return not_subbed


async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_id = update.effective_user.id
    not_subbed = await check_subscription(user_id, context)

    if not_subbed:
        buttons = [
            [InlineKeyboardButton(f"📢 {ch}", url=f"https://t.me/{ch.replace('@', '')}")]
            for ch in not_subbed
        ]
        buttons.append([InlineKeyboardButton("✅ Obunani tekshirish", callback_data="check_sub")])
        await update.message.reply_text(
            "Assalomu alaykum! Botdan foydalanish uchun quyidagi kanal(lar)ga obuna bo'ling:",
            reply_markup=InlineKeyboardMarkup(buttons)
        )
        return CHECK_SUB

    return await request_phone(update, context)


async def check_sub_callback(update: Update, context: ContextTypes.DEFAULT_TYPE):
    query = update.callback_query
    await query.answer()
    user_id = query.from_user.id
    not_subbed = await check_subscription(user_id, context)

    if not not_subbed:
        await query.message.delete()
        await context.bot.send_message(chat_id=user_id, text="✅ Obuna tasdiqlandi!")
        return await request_phone(update, context)
    else:
        await query.message.reply_text("❌ Siz hali barcha kanal(lar)ga obuna bo'lmadingiz!")
        return CHECK_SUB


async def request_phone(update: Update, context: ContextTypes.DEFAULT_TYPE):
    keyboard = ReplyKeyboardMarkup(
        [[KeyboardButton("📱 Telefon raqamni yuborish", request_contact=True)]],
        resize_keyboard=True, one_time_keyboard=True
    )
    if update.message:
        await update.message.reply_text("Iltimos, telefon raqamingizni yuboring:", reply_markup=keyboard)
    else:
        await context.bot.send_message(
            chat_id=update.effective_user.id,
            text="Iltimos, telefon raqamingizni yuboring:",
            reply_markup=keyboard
        )
    return GET_PHONE


async def get_phone(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    phone = update.message.contact.phone_number if update.message.contact else update.message.text
    user_orders[user.id] = {'phone': phone}
    db.save_user(user.id, user.username, user.full_name, phone)
    return await main_menu(update, context)


