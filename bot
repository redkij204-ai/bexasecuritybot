# --- BUYURTMANI KANALGA YUBORISH ---
# =========================================================
async def send_order_to_channel(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user = update.effective_user
    order = user_orders.get(user.id, {})
    price = order.get('price', 0)

    order_id = db.save_order({
        'user_id': user.id,
        'service': order.get('service', '-'),
        'quality': order.get('quality'),
        'amount': order.get('amount'),
        'link': order.get('link'),
        'target_user': order.get('target_user'),
        'details': order.get('details'),
        'price': price,
    })

    full_name = html.escape(user.full_name or "")
    username_safe = html.escape(user.username or "Yo'q")

    text = "📥 <b>Yangi Buyurtma!</b>\n\n"
    text += f"🆔 <b>Buyurtma raqami:</b> #{order_id}\n"
    text += f"👤 <b>Mijoz:</b> {full_name} (@{username_safe})\n"
    text += f"📞 <b>Tel:</b> <code>{html.escape(str(order.get('phone', 'Kiritilmagan')))}</code>\n"
    text += f"🛠 <b>Xizmat:</b> {html.escape(str(order.get('service', '-')))}\n"

    if order.get('quality'):
        text += f"✨ <b>Sifat:</b> {html.escape(order['quality'])}\n"
    if order.get('amount'):
        text += f"🔢 <b>Miqdor:</b> {html.escape(order['amount'])}\n"
    if order.get('link'):
        text += f"🔗 <b>Link:</b> {html.escape(order['link'])}\n"
    if order.get('target_user'):
        text += f"🎯 <b>Nishon:</b> {html.escape(order['target_user'])}\n"
    if order.get('details'):
        text += f"📝 <b>Batafsil:</b> {html.escape(order['details'])}\n"
    if price:
        text += f"💰 <b>Narx:</b> {format_price(price)}\n"

    admin_keyboard = InlineKeyboardMarkup([[
        InlineKeyboardButton("✅ Bajarildi", callback_data=f"order_done_{order_id}"),
        InlineKeyboardButton("❌ Rad etildi", callback_data=f"order_reject_menu_{order_id}")
    ]])

    try:
        await context.bot.send_message(chat_id=CHANNEL_ID, text=text, parse_mode="HTML", reply_markup=admin_keyboard)
        await update.message.reply_text(f"✅ Buyurtmangiz qabul qilindi! (#{order_id})\nOperatormiz tez orada siz bilan bog'lanadi.")
    except Exception as e:
        await update.message.reply_text(f"❌ Xatolik: Buyurtma kanalga yuborilmadi.\nSabab: {e}")
        logger.error(f"Kanalga yuborishda xatolik: {e}")

    return await main_menu(update, context)


