async def my_orders(update: Update, context: ContextTypes.DEFAULT_TYPE):
    orders = db.get_user_orders(update.effective_user.id)
    if not orders:
        await update.message.reply_text("📭 Sizda hali buyurtmalar yo'q.")
        return MAIN_MENU

    status_map = {"pending": "⏳ Kutilmoqda", "done": "✅ Bajarildi", "rejected": "❌ Rad etildi"}
    text = "📦 <b>Sizning buyurtmalaringiz:</b>\n\n"
    for o in orders[:15]:
        text += f"#{o['id']} — {html.escape(o['service'] or '-')}\n"
        text += f"   {status_map.get(o['status'], o['status'])}"
        if o['status'] == 'rejected' and o['reject_reason']:
            text += f" ({html.escape(o['reject_reason'])})"
        if o['price']:
            text += f" · {format_price(o['price'])}"
        text += "\n\n"
    await update.message.reply_text(text, parse_mode="HTML")
    return MAIN_MENU


